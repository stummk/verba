# Verba systemd unit — install to /etc/systemd/system/verba.service
#
#   sudo useradd --system --create-home --home-dir /opt/verba verba   # once
#   sudo cp deploy/verba.service /etc/systemd/system/verba.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now verba
#
# Assumes Verba was installed to /opt/verba via deploy/install.sh
# (which creates the virtualenv at /opt/verba/.venv).
#
# The bound address is printed on every start and captured by the journal:
#   systemctl status verba          # last lines, including the address block
#   journalctl -u verba | head -20  # the banner of the current start

[Unit]
Description=Verba transcription server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=verba
Group=verba
WorkingDirectory=/opt/verba
ExecStart=/opt/verba/.venv/bin/python run.py --server --port 8710
# on-failure also covers the update: Verba exits with code 42 after it has
# installed a new version, and systemd starts the new one (see
# backend/verba/services/updates.py)
Restart=on-failure
RestartSec=5

# unbuffered stdout, so the address block reaches the journal immediately
Environment=PYTHONUNBUFFERED=1

# Runtime data (settings, database, models, logs) lives under /opt/verba/data.
Environment=VERBA_DATA_DIR=/opt/verba/data

# Behind a reverse proxy that terminates TLS, Verba reads the browser's
# scheme from X-Forwarded-Proto and marks the session cookie Secure from it.
# That header is trusted from 127.0.0.1 only; uncomment and set the proxy's
# address if it runs on another host.
# Environment=FORWARDED_ALLOW_IPS=10.0.0.2

# Hardening — relax if a workspace outside /opt/verba is configured.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/verba

# Settings -> Updates offers a button that updates the machine's own packages
# (apt-get update/upgrade). With this unit as it stands it is inactive, and
# deliberately so: the service runs as "verba", and three of the lines above
# deny it root in every direction — User=verba, NoNewPrivileges=true (sudo is
# setuid, so this switches it off) and ProtectSystem=full (/usr and /etc are
# read-only, so dpkg would not get through even as root). Installing Verba as
# root does not change any of that.
#
# To offer the button, allow the service user apt-get and `true` — Verba probes
# the rights with `sudo -n true`, so that has to be allowed as well:
#
#   printf 'verba ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/true, /bin/true\n' \
#       | sudo tee /etc/sudoers.d/verba-apt >/dev/null
#   sudo chmod 440 /etc/sudoers.d/verba-apt
#   sudo visudo -c
#
# and relax the two hardening lines that stand in apt's way, via
# `sudo systemctl edit verba`:
#
#   [Service]
#   NoNewPrivileges=false
#   ProtectSystem=no
#
# Leaving it inactive is a valid choice: `apt upgrade` over SSH does the same
# thing, and Verba then needs no more rights than it otherwise has.

[Install]
WantedBy=multi-user.target
